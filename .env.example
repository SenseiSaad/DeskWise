# Secrets for docker compose & local development.
# Copy to .env (backend/.env) and fill in real values. NEVER commit .env files.

# ── Required ──────────────────────────────────────────────────────────
# Leave blank: ./scripts/start_local.sh generates one on first run.
SECRET_KEY=
DOMAIN=deskwise.example.com

# ── Host ports (change only if 8000/3000 are busy; then also update
#    NEXT_PUBLIC_API_URL, CORS_ALLOWED_ORIGINS, CSRF_TRUSTED_ORIGINS, PUBLIC_BASE_URL) ──
# API_PORT=8000
# WEB_PORT=3000

# ── Runtime ───────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
ALLOW_INSECURE_HTTP=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
COOKIE_SECURE=false

# Email verification gate (off until SMTP is configured)
REQUIRE_EMAIL_VERIFICATION=false

# ── Feature Flags & Defaults ──────────────────────────────────────────
# Turn attendance tracking on/off globally (default: true)
ENABLE_ATTENDANCE=true
# Auto-freeze accounts on 3 strikes (default: false / warn-only mode for legal compliance)
ATTENDANCE_AUTO_FREEZE=false
# Turn document and template generation (forms/letters/emails) on/off (default: true)
ENABLE_DOCGEN=true

# ── AI Providers ──────────────────────────────────────────────────────
# Local Ollama on the host, or an online provider key.
LLM_PROVIDER=ollama
# Beta provider lock, inlined into the frontend at build time.
#   gemini = only Google Gemini selectable (what production uses)
#   off    = all providers selectable — handy for local testing
# Left unset: local Docker Compose defaults to "off", production to "gemini".
# Set it explicitly only to override that.
# NEXT_PUBLIC_BETA_PROVIDER=off
LLM_URL=http://host.docker.internal:11434
LLM_MODEL=qwen2.5:0.5b
OLLAMA_KEEP_ALIVE=30m
SELFHOSTED_LLM_URL=
SELFHOSTED_LLM_MODEL=qwen2.5:7b
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# AWS Bedrock (ap-south-1). Production uses ECS IAM Task Role.
BEDROCK_API_KEY=
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL=in.anthropic.claude-3-5-haiku-20241022-v1:0
# Stable Fernet encryption key for encrypting provider keys saved in the UI.
LLM_KEY_ENCRYPTION_KEY=

# ── Email (SMTP) ──────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Deskwise <no-reply@deskwise.example.com>

# ── Stripe Billing (Sandbox or Live) ──────────────────────────────────
# Test keys start with sk_test_ and pk_test_. Leave blank for offline billing.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── PostgreSQL (only used with: docker compose --profile pg up -d) ────
# POSTGRES_DB=deskwise
# POSTGRES_USER=deskwise_user
# POSTGRES_PASSWORD=replace-with-secure-db-password
# POSTGRES_HOST=db

# ── Redis (only used with: docker compose --profile redis up -d) ───────
# CACHE_URL=redis://redis:6379/0
